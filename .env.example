NODE_ENV=development
PORT=3000

# Local Postgres (created via Homebrew postgresql@16 for local dev)
DATABASE_URL=postgresql://rifa:rifa_dev_pw@localhost:5432/rifa_app
TEST_DATABASE_URL=postgresql://rifa:rifa_dev_pw@localhost:5432/rifa_app_test

# Generate a long random string for production, e.g.: openssl rand -hex 32
SESSION_SECRET=change-me-generate-a-long-random-string

# Set to true only in dev/staging to load demo data via `npm run seed`
ALLOW_SEED=true

# Set to true in production when served over HTTPS
COOKIE_SECURE=false

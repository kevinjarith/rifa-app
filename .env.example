NODE_ENV=development
PORT=3000

# Local Postgres (created via Homebrew postgresql@16 for local dev): DATABASE_URL
# and DIRECT_URL can just be the same local connection string — pooling only
# matters in production, when deployed to Vercel in front of Supabase.
DATABASE_URL=postgresql://rifa:rifa_dev_pw@localhost:5432/rifa_app
DIRECT_URL=postgresql://rifa:rifa_dev_pw@localhost:5432/rifa_app
TEST_DATABASE_URL=postgresql://rifa:rifa_dev_pw@localhost:5432/rifa_app_test

# --- Producción en Vercel + Supabase ---
# DATABASE_URL: el connection string "Transaction pooler" de Supabase (puerto
#   6543), con ?pgbouncer=true&connection_limit=1 al final — usado por la app
#   en cada invocación de la función serverless.
# DIRECT_URL: el connection string directo de Supabase (puerto 5432, sin
#   pgbouncer) — usado solo por `prisma migrate deploy` durante el build.
# Ambos se copian desde el panel de Supabase: Project Settings → Database.

# Generate a long random string for production, e.g.: openssl rand -hex 32
SESSION_SECRET=change-me-generate-a-long-random-string

# Set to true only in dev/staging to load demo data via `npm run seed`
ALLOW_SEED=true

# Set to true in production when served over HTTPS
COOKIE_SECURE=false
